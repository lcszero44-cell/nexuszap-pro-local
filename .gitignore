*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.mdb
*.accdb
data/*.sqlite
data/*.db
data/planilhas/*.xlsx
data/planilhas/*.xls
data/planilhas/*.csv
data/uploads/
data/uploads/*

